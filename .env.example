# Flappy Jev: environment. Copy to .env and fill in.
# .env, .env.example and prod.env carry the same variables in the same order.
# Tuning numbers (physics, thresholds, timeouts, model name) are NOT here: see constants.js.

# --- TypeSafe (Jev) ---
# REQUIRED for Jev to fly. Without it the game still starts and you can fly by hand.
TYPESAFE_API_KEY=<your TypeSafe API key>
# Optional. Default: https://api.typesafe.ai  (the tests point this at a local stand-in)
TYPESAFE_API_URL=https://api.typesafe.ai

# --- Server ---
# Optional. Default: 4173
PORT=4173
